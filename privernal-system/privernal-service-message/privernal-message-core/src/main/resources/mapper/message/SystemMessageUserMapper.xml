<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.privernal.message.mapper.SystemMessageUserMapper">

    <resultMap type="com.privernal.message.dto.SystemMessageUserDTO" id="SystemMessageUserResult">
        <result property="id"    column="id"    />
        <result property="messageId"    column="message_id"    />
        <result property="userId"    column="user_id"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="revision"    column="revision"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedBy"    column="updated_by"    />
        <result property="updatedTime"    column="updated_time"    />
        <result property="deletedBy"    column="deleted_by"    />
        <result property="deletedTime"    column="deleted_time"    />
        <result property="deletedFlag"    column="deleted_flag"    />
    </resultMap>

    <sql id="selectSystemMessageUserVo">
        select id, message_id, user_id, status, remark, tenant_id, revision, created_by, created_time, updated_by, updated_time, deleted_by, deleted_time, deleted_flag from system_message_user as messageUser
    </sql>

    <select id="selectSystemMessageUserList" parameterType="com.privernal.message.filter.SystemMessageUserFilterDTO" resultMap="SystemMessageUserResult">
        <include refid="selectSystemMessageUserVo"/>
        <where>
            deleted_flag = 'N'
            <if test="messageId != null  and messageId != ''"> and message_id = #{messageId}</if>
            <if test="userId != null  and userId != ''"> and user_id = #{userId}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="remark != null  and remark != ''"> and remark = #{remark}</if>
        </where>
    </select>

    <resultMap type="com.privernal.message.domain.SystemMessageUser" id="SystemMessageUserR">
        <result property="id"    column="id"    />
        <result property="messageId"    column="message_id"    />
        <result property="userId"    column="user_id"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="revision"    column="revision"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedBy"    column="updated_by"    />
        <result property="updatedTime"    column="updated_time"    />
        <result property="deletedBy"    column="deleted_by"    />
        <result property="deletedTime"    column="deleted_time"    />
        <result property="deletedFlag"    column="deleted_flag"    />
    </resultMap>
    <select id="selectSystemMessageUserByMessageId"  resultMap="SystemMessageUserR">
        <include refid="selectSystemMessageUserVo"/>
        <where>
            deleted_flag = 'N'
            <if test="messageId != null  and messageId != ''"> and message_id = #{messageId}</if>
            <if test="userId != null  and userId != ''"> and user_id = #{userId}</if>
        </where>
    </select>

    <update id="updateReadAll" >
        update system_message_user  set status = 1 where user_id = #{userId} and deleted_flag = 'N'
    </update>
</mapper>
