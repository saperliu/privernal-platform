<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.privernal.system.mapper.SystemRoleGroupRoleMapper">

    <resultMap type="com.privernal.system.domain.SystemRoleGroupRole" id="SystemRoleGroupRoleResult">
        <result property="tenantId"    column="tenant_id"    />
        <result property="revision"    column="revision"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedBy"    column="updated_by"    />
        <result property="updatedTime"    column="updated_time"    />
        <result property="deletedBy"    column="deleted_by"    />
        <result property="deletedTime"    column="deleted_time"    />
        <result property="deletedFlag"    column="deleted_flag"    />
        <result property="id"    column="id"    />
        <result property="remark"    column="remark"    />
        <result property="groupId"    column="group_id"    />
        <result property="roleId"    column="role_id"    />
    </resultMap>

    <sql id="selectSystemRoleGroupRoleVo">
        select tenant_id, revision, created_by, created_time, updated_by, updated_time, deleted_by, deleted_time, deleted_flag, id, remark, group_id, role_id from system_role_group_role as roleGroupRole
    </sql>

    <select id="selectSystemRoleGroupRoleList" parameterType="com.privernal.system.filter.SystemRoleGroupRoleFilterDTO" resultMap="SystemRoleGroupRoleResult">
        <include refid="selectSystemRoleGroupRoleVo"/>
        <where>
            deleted_flag = 'N'
            <if test="remark != null  and remark != ''"> and remark = #{remark}</if>
            <if test="groupId != null  and groupId != ''"> and group_id = #{groupId}</if>
            <if test="roleId != null  and roleId != ''"> and role_id = #{roleId}</if>
        </where>
    </select>


</mapper>
