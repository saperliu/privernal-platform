<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.privernal.system.mapper.SystemPositionMapper">

    <resultMap type="com.privernal.system.domain.SystemPosition" id="SystemPositionResult">
        <result property="tenantId"    column="tenant_id"    />
        <result property="revision"    column="revision"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedBy"    column="updated_by"    />
        <result property="updatedTime"    column="updated_time"    />
        <result property="deletedFlag"    column="deleted_flag"    />
        <result property="deletedBy"    column="deleted_by"    />
        <result property="deletedTime"    column="deleted_time"    />
        <result property="id"    column="id"    />
        <result property="remark"    column="remark"    />
        <result property="positionName"    column="position_name"    />
        <result property="positionCode"    column="position_code"    />
        <result property="status"    column="status"    />
        <result property="orderNum"    column="order_num"    />
        <result property="organizationId"    column="organization_id"    />
        <result property="departmentId"    column="department_id"    />
    </resultMap>

    <sql id="selectSystemPositionVo">
        select tenant_id, revision, created_by, created_time, updated_by, updated_time, deleted_flag, deleted_by, deleted_time, id, remark, position_name, position_code, status, order_num, organization_id, department_id from system_position as position
    </sql>

    <select id="selectSystemPositionList" parameterType="com.privernal.system.filter.SystemPositionFilterDTO" resultMap="SystemPositionResult">
        <include refid="selectSystemPositionVo"/>
        <where>
            deleted_flag = 'N'
            <if test="id != null  and id != ''"> and id = #{id}</if>
            <if test="remark != null  and remark != ''"> and remark = #{remark}</if>
            <if test="positionName != null  and positionName != ''"> and position_name like concat('%', #{positionName}, '%')</if>
            <if test="positionCode != null  and positionCode != ''"> and position_code = #{positionCode}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="orderNum != null "> and order_num = #{orderNum}</if>
            <if test="organizationId != null  and organizationId != ''"> and organization_id = #{organizationId}</if>
            <if test="departmentId != null  and departmentId != ''"> and department_id = #{departmentId}</if>
            <if test="keywords!=null and keywords.length>0">
                and
                <foreach collection="keywords" item="item" open="(" separator="and" close=")">
                    (
                    position.position_name like concat('%', #{item}, '%')
                    or position.remark like concat('%', #{item}, '%')
                    or position.position_code like concat('%', #{item}, '%')
                    )
                </foreach>
            </if>
        </where>
        order by position.created_time desc
    </select>


    <resultMap type="com.privernal.system.dto.SystemUserPositionDTO" id="SystemUserPositionDTO">
        <result property="tenantId"    column="tenant_id"    />
        <result property="revision"    column="revision"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedBy"    column="updated_by"    />
        <result property="updatedTime"    column="updated_time"    />
        <result property="deletedFlag"    column="deleted_flag"    />
        <result property="deletedBy"    column="deleted_by"    />
        <result property="deletedTime"    column="deleted_time"    />
        <result property="id"    column="id"    />
        <result property="remark"    column="remark"    />
        <result property="positionId"    column="position_id"    />
        <result property="userId"    column="user_id"    />
        <result property="loginName"    column="login_name"    />
        <result property="nickName"    column="nick_name"    />
        <result property="email"    column="email"    />
        <result property="phone"    column="phone"    />
        <result property="status"    column="status"    />
    </resultMap>

    <select id="selectSystemUserPositionList" parameterType="String" resultMap="SystemUserPositionDTO">
        select positionUser.created_by, positionUser.created_time, positionUser.updated_by, positionUser.updated_time, positionUser.id, positionUser.user_id, positionUser.position_id,
        user1.remark, user1.login_name, user1.status,
        user1.nick_name, user1.email, user1.phone
        from system_user_position as positionUser
        left join system_user_base as user1 on positionUser.user_id = user1.id
        where positionUser.position_id = #{positionId} and user1.deleted_flag = 'N' and positionUser.deleted_flag = 'N'
        <if test="nickName != null  and nickName != ''"> and user1.nick_name like concat('%', #{nickName}, '%')</if>
    </select>


</mapper>
