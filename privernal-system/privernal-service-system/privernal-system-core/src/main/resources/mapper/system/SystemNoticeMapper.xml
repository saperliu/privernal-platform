<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.privernal.system.mapper.SystemNoticeMapper">

    <resultMap type="com.privernal.system.domain.SystemNotice" id="SystemNoticeResult">
        <result property="tenantId"    column="tenant_id"    />
        <result property="revision"    column="revision"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedBy"    column="updated_by"    />
        <result property="updatedTime"    column="updated_time"    />
        <result property="deletedBy"    column="deleted_by"    />
        <result property="deletedTime"    column="deleted_time"    />
        <result property="deletedFlag"    column="deleted_flag"    />
        <result property="id"    column="id"    />
        <result property="remark"    column="remark"    />
        <result property="noticeTitle"    column="notice_title"    />
        <result property="noticeType"    column="notice_type"    />
        <result property="content"    column="content"    />
        <result property="status"    column="status"    />
        <result property="detailUrl"    column="detail_url"    />
        <result property="organizationId"    column="organization_id"    />
        <result property="departmentId"    column="department_id"    />
    </resultMap>

    <sql id="selectSystemNoticeVo">
        select tenant_id, revision, created_by, created_time, updated_by, updated_time, deleted_by, deleted_time, deleted_flag, id, remark, notice_title, notice_type, content, status, detail_url, organization_id, department_id from system_notice as notice
    </sql>

    <select id="selectSystemNoticeList" parameterType="com.privernal.system.filter.SystemNoticeFilterDTO" resultMap="SystemNoticeResult">
        <include refid="selectSystemNoticeVo"/>
        <where>
            deleted_flag = 'N'
            <if test="remark != null  and remark != ''"> and remark = #{remark}</if>
            <if test="noticeTitle != null  and noticeTitle != ''"> and notice_title = #{noticeTitle}</if>
            <if test="noticeType != null  and noticeType != ''"> and notice_type = #{noticeType}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="detailUrl != null  and detailUrl != ''"> and detail_url = #{detailUrl}</if>
            <if test="organizationId != null  and organizationId != ''"> and organization_id = #{organizationId}</if>
            <if test="departmentId != null  and departmentId != ''"> and department_id = #{departmentId}</if>
        </where>
        order by created_time desc
    </select>


</mapper>
