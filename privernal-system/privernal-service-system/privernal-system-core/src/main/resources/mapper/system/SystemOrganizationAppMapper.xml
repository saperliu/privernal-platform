<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.privernal.system.mapper.SystemOrganizationAppMapper">

    <resultMap type="com.privernal.system.dto.SystemOrganizationAppDTO" id="SystemOrganizationAppResult">

        <result property="id" column="id"/>

        <result property="appId" column="app_id"/>

        <result property="status" column="status"/>

        <result property="organizationId" column="organization_id"/>

        <result property="tenantId" column="tenant_id"/>

        <result property="revision" column="revision"/>

        <result property="createdBy" column="created_by"/>

        <result property="createdTime" column="created_time"/>

        <result property="updatedBy" column="updated_by"/>

        <result property="updatedTime" column="updated_time"/>

        <result property="deletedTime" column="deleted_time"/>

        <result property="deletedBy" column="deleted_by"/>

        <result property="deletedFlag" column="deleted_flag"/>

        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectSystemOrganizationAppVo">
        select organizationApp.id,
               organizationApp.app_id,
               organizationApp.status,
               organizationApp.organization_id,
               organizationApp.tenant_id,
               organizationApp.revision,
               organizationApp.created_by,
               organizationApp.created_time,
               organizationApp.updated_by,
               organizationApp.updated_time,
               organizationApp.deleted_time,
               organizationApp.deleted_by,
               organizationApp.deleted_flag,
               organizationApp.remark
        from system_organization_app as organizationApp
    </sql>

    <select id="selectSystemOrganizationAppList" parameterType="com.privernal.system.filter.SystemOrganizationAppFilterDTO"
            resultMap="SystemOrganizationAppResult">
        <include refid="selectSystemOrganizationAppVo"/>
        <where>
            organizationApp.deleted_flag = 'N'
            <if test="appId != null  and appId != ''">and organizationApp.app_id = #{appId}</if>
            <if test="status != null ">and organizationApp.status = #{status}</if>
            <if test="organizationId != null  and organizationId != ''">and organizationApp.organization_id =
                #{organizationId}
            </if>
            <if test="remark != null  and remark != ''">and organizationApp.remark like concat('%', #{remark}, '%')</if>
            <if test="keywords!=null and keywords.length>0">
                and
                <foreach collection="keywords" item="item" open="(" separator="and" close=")">
                    (
                    organizationApp.remark like concat('%', #{item}, '%')
                    )
                </foreach>
            </if>
        </where>
        order by organizationApp.created_time desc
    </select>


</mapper>
