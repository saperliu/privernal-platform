<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.privernal.system.mapper.SystemUserAppMenuMapper">

    <resultMap type="com.privernal.system.dto.SystemUserAppMenuDTO" id="SystemUserAppMenuResult">

        <result property="id" column="id"/>

        <result property="userId" column="user_id"/>

        <result property="menuId" column="menu_id"/>

        <result property="status" column="status"/>

        <result property="remark" column="remark"/>

        <result property="tenantId" column="tenant_id"/>

        <result property="revision" column="revision"/>

        <result property="createdBy" column="created_by"/>

        <result property="createdTime" column="created_time"/>

        <result property="updatedBy" column="updated_by"/>

        <result property="updatedTime" column="updated_time"/>

        <result property="deletedFlag" column="deleted_flag"/>

        <result property="deletedBy" column="deleted_by"/>

        <result property="deletedTime" column="deleted_time"/>

        <result property="organizationId" column="organization_id"/>
    </resultMap>

    <sql id="selectSystemUserAppMenuVo">
        select userAppMenu.id,
               userAppMenu.user_id,
               userAppMenu.menu_id,
               userAppMenu.status,
               userAppMenu.remark,
               userAppMenu.tenant_id,
               userAppMenu.revision,
               userAppMenu.created_by,
               userAppMenu.created_time,
               userAppMenu.updated_by,
               userAppMenu.updated_time,
               userAppMenu.deleted_flag,
               userAppMenu.deleted_by,
               userAppMenu.deleted_time,
               userAppMenu.organization_id
        from system_user_app_menu as userAppMenu
    </sql>

    <select id="selectSystemUserAppMenuList" parameterType="com.privernal.system.filter.SystemUserAppMenuFilterDTO"
            resultMap="SystemUserAppMenuResult">
        <include refid="selectSystemUserAppMenuVo"/>
        <where>
            userAppMenu.deleted_flag = 'N'
            <if test="userId != null  and userId != ''">and userAppMenu.user_id = #{userId}</if>
            <if test="menuId != null  and menuId != ''">and userAppMenu.menu_id = #{menuId}</if>
            <if test="status != null ">and userAppMenu.status = #{status}</if>
            <if test="remark != null  and remark != ''">and userAppMenu.remark like concat('%', #{remark}, '%')</if>
            <if test="organizationId != null  and organizationId != ''">and userAppMenu.organization_id =
                #{organizationId}
            </if>
            <if test="keywords!=null and keywords.length>0">
                and
                <foreach collection="keywords" item="item" open="(" separator="and" close=")">
                    (
                    userAppMenu.remark like concat('%', #{item}, '%')
                    )
                </foreach>
            </if>
        </where>
        order by userAppMenu.created_time desc
    </select>


</mapper>
