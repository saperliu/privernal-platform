<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.privernal.system.mapper.SystemAppPathMapper">

    <resultMap type="com.privernal.system.dto.SystemAppPathDTO" id="SystemAppPathResult">

        <result property="id" column="id"/>

        <result property="appId" column="app_id"/>

        <result property="path" column="path"/>

        <result property="status" column="status"/>

        <result property="remark" column="remark"/>

        <result property="tenantId" column="tenant_id"/>

        <result property="revision" column="revision"/>

        <result property="createdBy" column="created_by"/>

        <result property="createdTime" column="created_time"/>

        <result property="updatedBy" column="updated_by"/>

        <result property="updatedTime" column="updated_time"/>

        <result property="deletedFlag" column="deleted_flag"/>

        <result property="deletedBy" column="deleted_by"/>

        <result property="deletedTime" column="deleted_time"/>

        <result property="organizationId" column="organization_id"/>
    </resultMap>

    <sql id="selectSystemAppPathVo">
        select appPath.id,
               appPath.app_id,
               appPath.path,
               appPath.status,
               appPath.remark,
               appPath.tenant_id,
               appPath.revision,
               appPath.created_by,
               appPath.created_time,
               appPath.updated_by,
               appPath.updated_time,
               appPath.deleted_flag,
               appPath.deleted_by,
               appPath.deleted_time,
               appPath.organization_id
        from system_app_path as appPath
    </sql>

    <select id="selectSystemAppPathList" parameterType="com.privernal.system.filter.SystemAppPathFilterDTO"
            resultMap="SystemAppPathResult">
        <include refid="selectSystemAppPathVo"/>
        <where>
            appPath.deleted_flag = 'N'
            <if test="appId != null  and appId != ''">and appPath.app_id = #{appId}</if>
            <if test="path != null  and path != ''">and appPath.path = #{path}</if>
            <if test="status != null ">and appPath.status = #{status}</if>
            <if test="remark != null  and remark != ''">and appPath.remark like concat('%', #{remark}, '%')</if>
            <if test="organizationId != null  and organizationId != ''">and appPath.organization_id =
                #{organizationId}
            </if>
            <if test="keywords!=null and keywords.length>0">
                and
                <foreach collection="keywords" item="item" open="(" separator="and" close=")">
                    (
                    appPath.remark like concat('%', #{item}, '%')
                    )
                </foreach>
            </if>
        </where>
        order by appPath.created_time desc
    </select>


</mapper>
