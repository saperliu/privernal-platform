<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.privernal.system.mapper.SystemOrganizationMenuMapper">

    <resultMap type="com.privernal.system.dto.SystemOrganizationMenuDTO" id="SystemOrganizationMenuResult">
        <result property="id"    column="id"    />
        <result property="menuId"    column="menu_id"    />
        <result property="status"    column="status"    />
        <result property="organizationId"    column="organization_id"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="revision"    column="revision"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedBy"    column="updated_by"    />
        <result property="updatedTime"    column="updated_time"    />
        <result property="deletedTime"    column="deleted_time"    />
        <result property="deletedBy"    column="deleted_by"    />
        <result property="deletedFlag"    column="deleted_flag"    />
        <result property="remark"    column="remark"    />
        <result property="appId"    column="app_id"    />
    </resultMap>

    <sql id="selectSystemOrganizationMenuVo">
        select id, menu_id, status, organization_id, app_id, tenant_id, revision, created_by, created_time, updated_by, updated_time, deleted_time, deleted_by, deleted_flag, remark from system_organization_menu as organizationMenu
    </sql>

    <select id="selectSystemOrganizationMenuList" parameterType="com.privernal.system.filter.SystemOrganizationMenuFilterDTO" resultMap="SystemOrganizationMenuResult">
        <include refid="selectSystemOrganizationMenuVo"/>
        <where>
            deleted_flag = 'N'
            <if test="menuId != null  and menuId != ''"> and menu_id = #{menuId}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="organizationId != null  and organizationId != ''"> and organization_id = #{organizationId}</if>
            <if test="remark != null  and remark != ''"> and remark = #{remark}</if>
        </where>
    </select>

    <select id="selectMenuAllByOrganizationId" parameterType="String" resultMap="SystemOrganizationMenuResult">
        <include refid="selectSystemOrganizationMenuVo"/>
        <where>
            organization_id = #{organizationId} and status=1 and  deleted_flag='N'
        </where>
    </select>

    <select id="selectSystemOrganizationMenuListByAppId" parameterType="String" resultMap="SystemOrganizationMenuResult">
        <include refid="selectSystemOrganizationMenuVo"/>
        <where>
            organization_id = #{organizationId} and  app_id = #{appId}   and status=1 and  deleted_flag='N'
        </where>
    </select>

    <delete id="deleteAllOrganizationMenuByAppIdAndMenuId">
        delete rolem from system_organization_menu as rolem
        where  rolem.app_id = #{appId} and  rolem.menu_id in (
        <foreach collection="menuIds" item="id" separator=",">
            #{id}
        </foreach>
        )
    </delete>
</mapper>
