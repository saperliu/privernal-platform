<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.privernal.system.mapper.SystemUserServiceOrgMapper">

    <resultMap type="com.privernal.system.domain.SystemUserServiceOrg" id="SystemUserServiceOrgResult">
        <result property="tenantId"    column="tenant_id"    />
        <result property="revision"    column="revision"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedBy"    column="updated_by"    />
        <result property="updatedTime"    column="updated_time"    />
        <result property="deletedFlag"    column="deleted_flag"    />
        <result property="deletedBy"    column="deleted_by"    />
        <result property="deletedTime"    column="deleted_time"    />
        <result property="id"    column="id"    />
        <result property="remark"    column="remark"    />
        <result property="userId"    column="user_id"    />
        <result property="organizationId"    column="organization_id"    />
        <result property="dataScope"    column="data_scope"    />
        <result property="departmentId"    column="department_id"    />
    </resultMap>

    <sql id="selectSystemUserServiceOrgVo">
        select tenant_id, revision, created_by, created_time, updated_by, updated_time, deleted_flag, deleted_by, deleted_time, id, remark, user_id, organization_id, data_scope, department_id from system_user_service_org as userServiceOrg
    </sql>

    <select id="selectSystemUserServiceOrgList" parameterType="com.privernal.system.filter.SystemUserServiceOrgFilterDTO" resultMap="SystemUserServiceOrgResult">
        <include refid="selectSystemUserServiceOrgVo"/>
        <where>
            deleted_flag = 'N'
            <if test="remark != null  and remark != ''"> and remark = #{remark}</if>
            <if test="userId != null  and userId != ''"> and user_id = #{userId}</if>
            <if test="organizationId != null  and organizationId != ''"> and organization_id = #{organizationId}</if>
            <if test="dataScope != null "> and data_scope = #{dataScope}</if>
            <if test="departmentId != null  and departmentId != ''"> and department_id = #{departmentId}</if>
            <if test="dataScope != null  and dataScope != ''"> and  #{dataScope}</if>
        </where>
    </select>


</mapper>
