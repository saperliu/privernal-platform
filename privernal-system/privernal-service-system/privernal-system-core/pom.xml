<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.privernal</groupId>
        <artifactId>privernal-service-system</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>privernal-system-core</artifactId>

    <description>
        系统用户模块
    </description>

    <properties>
        <!-- 集成 shardingsphere JDK版本问题，需要更低版本  -->
        <jaxb-sun.version>2.3.0</jaxb-sun.version>
    </properties>

    <dependencies>

        <!-- SpringBoot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- SpringBoot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-undertow</artifactId>
        </dependency>

        <!--      阿里钉钉的服务端接口调用依赖 start  -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>dingtalk</artifactId>
        </dependency>

         <!--        旧版，因为有些接口还不支持新版2023-01-31 -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>alibaba-dingtalk-service-sdk</artifactId>
            <exclusions>
                <!--    与 shardingsphere-jdbc-core 里的版本冲突-->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>tea</artifactId>
        </dependency>

        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>tea-openapi</artifactId>
            <exclusions>
                <!--    与 shardingsphere-jdbc-core 里的版本冲突-->
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk15on</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.dingtalk.open</groupId>
            <artifactId>app-stream-client</artifactId>
        </dependency>

        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>tea-util</artifactId>
        </dependency>
        <!--      阿里钉钉的服务端接口调用依赖 end  -->

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
        </dependency>
        <!-- Xvri Common DataSource -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-datasource</artifactId>
        </dependency>

        <!-- Xvri Common DataScope -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-datascope</artifactId>
        </dependency>

        <!-- Xvri Common Mybatis -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-mybatis</artifactId>
        </dependency>

        <!-- Xvri Common Log -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-log</artifactId>
        </dependency>

        <!-- Xvri Common Redis（流水号递增序列） -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-redis</artifactId>
        </dependency>


        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-dingtalk</artifactId>
        </dependency>

        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-wx</artifactId>
        </dependency>

        <!-- Api System  -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-system-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-file-api</artifactId>
        </dependency>

        <!-- 应用下架级联暂停定时任务（第7条） -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-job-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--各种小工具集合-->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!--        不添加下面2个包会报 NoClassDefFoundError: com/sun/xml/bind/v2/model/annotation/AnnotationReader 的错误-->
        <dependency>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-impl</artifactId>
            <version>${jaxb-sun.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-core</artifactId>
            <version>${jaxb-sun.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
