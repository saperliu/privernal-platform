<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.privernal</groupId>
        <artifactId>privernal-service-flow</artifactId>
        <version>${revision}</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <artifactId>privernal-flow-core</artifactId>

    <description>
        工作流核心模块（基于 warm-flow 引擎，融合组织部门人员角色与动态表单）
    </description>

    <dependencies>

        <!-- SpringBoot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- SpringBoot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-undertow</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Xvri Common DataSource -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-datasource</artifactId>
        </dependency>

        <!-- Xvri Common DataScope -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-datascope</artifactId>
        </dependency>

        <!-- Xvri Common Log -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-log</artifactId>
        </dependency>

        <!-- Xvri Common Mybatis -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-mybatis</artifactId>
        </dependency>

        <!-- 定时任务模块：warm-flow 超时任务化（SPI 与注册客户端在 job-api） -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-job-api</artifactId>
        </dependency>

        <!-- Xvri Common web -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-web</artifactId>
        </dependency>

        <!-- Xvri Common Security -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-common-security</artifactId>
        </dependency>

        <!-- 工作流接口 -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-flow-api</artifactId>
        </dependency>

        <!-- Xvri Api System（组织/部门/人员/角色解析） -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-system-api</artifactId>
        </dependency>

        <!-- Xvri Api Dynamic（动态表单业务状态回写） -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-dynamic-api</artifactId>
        </dependency>

        <!-- warm-flow 工作流引擎（MyBatis-Plus + SpringBoot3 适配） -->
        <dependency>
            <groupId>org.dromara.warm</groupId>
            <artifactId>warm-flow-mybatis-plus-sb3-starter</artifactId>
        </dependency>

        <!-- warm-flow 设计器后端接口（/warm-flow/**） -->
        <dependency>
            <groupId>org.dromara.warm</groupId>
            <artifactId>warm-flow-plugin-ui-sb-web</artifactId>
        </dependency>

        <!-- warm-flow 设计器静态页面（/warm-flow-ui/**） -->
        <dependency>
            <groupId>org.dromara.warm</groupId>
            <artifactId>warm-flow-plugin-vue3-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--各种小工具集合-->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!-- 网关流转条件表达式（wfexpr）的 Groovy 求值，版本由根 pom dependencyManagement 管理 -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-all</artifactId>
            <type>pom</type>
        </dependency>
        <!-- S9-4：网关条件表达式复用动态模块的 Groovy 沙箱（GroovySandboxConfig），
             与定时任务 GroovySandboxValidator 同一收口，避免第二套能绕过的版本 -->
        <dependency>
            <groupId>com.privernal</groupId>
            <artifactId>privernal-dynamic-core</artifactId>
            <version>${project.version}</version>
        </dependency>

            <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
